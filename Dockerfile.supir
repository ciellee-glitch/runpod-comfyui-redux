FROM ciellee78/worker-comfyui-redux:v7

# 诊断：打印启动脚本内容，找到超时阈值
RUN echo "=== ROOT FILES ===" && ls -la / | head -30
RUN echo "=== LOOKING FOR START SCRIPTS ===" && \
    for f in /start.sh /startup.sh /docker-entrypoint.sh /entrypoint.sh /run.sh; do \
        if [ -f "$f" ]; then echo "FOUND: $f" && cat "$f"; fi; \
    done
RUN echo "=== HANDLER FILES ===" && \
    find / -maxdepth 4 -name "handler.py" -o -name "rp_handler.py" -o -name "worker.py" 2>/dev/null | \
    xargs -I{} sh -c 'echo "=== {} ===" && head -60 {}'
RUN echo "=== CMD CHECK ===" && \
    cat /proc/1/cmdline 2>/dev/null | tr '\0' ' ' || true

# 安装 kijai/ComfyUI-SUPIR 自定义节点
RUN git clone --depth 1 https://github.com/kijai/ComfyUI-SUPIR \
    /comfyui/custom_nodes/ComfyUI-SUPIR

RUN printf 'from .util import get_configs_path, instantiate_from_config\n__version__ = "0.1.0"\n' \
    > /comfyui/custom_nodes/ComfyUI-SUPIR/sgm/__init__.py

RUN /opt/venv/bin/pip install \
    "open-clip-torch>=2.24.0" \
    omegaconf \
    "pytorch-lightning>=2.5.5" \
    accelerate

COPY save_jpeg/ /comfyui/custom_nodes/save_jpeg/
