FROM ciellee78/worker-comfyui-redux:v7
RUN git clone --depth 1 https://github.com/Fannovel16/comfyui_controlnet_aux \
    /comfyui/custom_nodes/comfyui_controlnet_aux && \
    /opt/venv/bin/pip install -r /comfyui/custom_nodes/comfyui_controlnet_aux/requirements.txt

# 调试：查看 requirements.txt 内容、node_wrappers 目录、depth_anything_v2 wrapper 前30行
RUN echo "=== requirements.txt ===" && \
    cat /comfyui/custom_nodes/comfyui_controlnet_aux/requirements.txt && \
    echo "=== node_wrappers/ ===" && \
    ls /comfyui/custom_nodes/comfyui_controlnet_aux/node_wrappers/ && \
    echo "=== depth_anything_v2.py head ===" && \
    head -30 /comfyui/custom_nodes/comfyui_controlnet_aux/node_wrappers/depth_anything_v2.py 2>/dev/null || true

COPY save_jpeg/ /comfyui/custom_nodes/save_jpeg/
