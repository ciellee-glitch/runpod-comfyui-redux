FROM ciellee78/worker-comfyui-redux:v7
RUN git clone --depth 1 https://github.com/Fannovel16/comfyui_controlnet_aux \
    /comfyui/custom_nodes/comfyui_controlnet_aux && \
    /opt/venv/bin/pip install -r /comfyui/custom_nodes/comfyui_controlnet_aux/requirements.txt && \
    /opt/venv/bin/pip install -e /comfyui/custom_nodes/comfyui_controlnet_aux

# 预下载预处理器模型，消除冷启动时的实时下载
RUN /opt/venv/bin/python -c "from custom_controlnet_aux.depth_anything_v2 import DepthAnythingV2Detector; DepthAnythingV2Detector.from_pretrained(filename='depth_anything_v2_vitl.pth'); print('DepthAnythingV2 OK')"
RUN /opt/venv/bin/python -c "from custom_controlnet_aux.hed import HEDdetector; HEDdetector.from_pretrained(); print('HED OK')"
RUN /opt/venv/bin/python -c "from custom_controlnet_aux.open_pose import OpenposeDetector; OpenposeDetector.from_pretrained(); print('OpenPose OK')"

COPY save_jpeg/ /comfyui/custom_nodes/save_jpeg/
