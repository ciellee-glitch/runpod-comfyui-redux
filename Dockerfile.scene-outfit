FROM ciellee78/worker-comfyui-redux:v7

RUN git clone --depth 1 https://github.com/Fannovel16/comfyui_controlnet_aux \
    /comfyui/custom_nodes/comfyui_controlnet_aux && \
    /opt/venv/bin/pip install -r /comfyui/custom_nodes/comfyui_controlnet_aux/requirements.txt && \
    /opt/venv/bin/pip install -e /comfyui/custom_nodes/comfyui_controlnet_aux && \
    /opt/venv/bin/pip install onnxruntime-gpu

# 预下载 preprocessor 模型到 ckpts/，避免 cold start 时下载超时
# custom_hf_download 只下文件，不 torch.load，无内存/CPU 压力
RUN /opt/venv/bin/python - <<'EOF'
import sys
sys.path.insert(0, '/comfyui/custom_nodes/comfyui_controlnet_aux/src')
from custom_controlnet_aux.util import custom_hf_download, HF_MODEL_NAME, DEPTH_ANYTHING_V2_MODEL_NAME_DICT
custom_hf_download(HF_MODEL_NAME, 'ControlNetHED.pth')
custom_hf_download(DEPTH_ANYTHING_V2_MODEL_NAME_DICT['depth_anything_v2_vitl.pth'], 'depth_anything_v2_vitl.pth')
custom_hf_download(HF_MODEL_NAME, 'body_pose_model.pth')
custom_hf_download(HF_MODEL_NAME, 'hand_pose_model.pth')
custom_hf_download(HF_MODEL_NAME, 'facenet.pth')
from huggingface_hub import hf_hub_download
hf_hub_download(repo_id='QuanSun/EVA-CLIP', filename='EVA02_CLIP_L_336_psz14_s6B.pt')
EOF

COPY save_jpeg/ /comfyui/custom_nodes/save_jpeg/
